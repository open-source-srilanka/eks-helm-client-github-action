# config.template
apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: ${CA_CERT}
    server: ${ENDPOINT_URL}
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    user: aws
  name: aws
current-context: aws
kind: Config
preferences: {}
users:
- name: aws
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args:
        - "eks"
        - "get-token"
        - "--cluster-name"
        - "${CLUSTER_NAME}"
        - "--region"
        - "${REGION_CODE}"
      # Provide a path to the aws-iam-authenticator binary if it's not in the PATH
      # env:
      # - name: PATH
      #   value: "/usr/local/bin:${PATH}"
      # install aws-iam-authenticator in the Dockerfile if not already.