apiVersion: v1
kind: Config
preferences: {}

clusters:
- cluster:
    server: ${CLUSTER_ENDPOINT}
    certificate-authority-data: ${CLUSTER_CA}
    # Enhanced security settings
    insecure-skip-tls-verify: false
    # Support for private clusters with custom CA
    ${CUSTOM_CA_CONFIG}
  name: ${CLUSTER_NAME}

contexts:
- context:
    cluster: ${CLUSTER_NAME}
    user: aws-user
    namespace: ${NAMESPACE}
  name: aws-context

current-context: aws-context

users:
- name: aws-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      env:
      - name: AWS_REGION
        value: ${REGION_CODE}
      # Support for STS regional endpoints
      - name: AWS_STS_REGIONAL_ENDPOINTS
        value: regional
      # Additional environment variables for private cluster access
      ${ADDITIONAL_ENV_VARS}
      args:
      - --region
      - ${REGION_CODE}
      - eks
      - get-token
      - --cluster-name
      - ${CLUSTER_NAME}
      # Optional: specify output format for better error handling
      - --output
      - json
      # Support for role assumption in the token command
      ${ROLE_ARN_ARGS}
      provideClusterInfo: true